+@@ -21,6 +23,9 @@
+ #define VEND1_GLOBAL_FW_ID_MAJOR		GENMASK(15, 8)
+ #define VEND1_GLOBAL_FW_ID_MINOR		GENMASK(7, 0)
+ 
++#define VEND1_GLOBAL_NVR_RESET			0x2680
++#define VEND1_GLOBAL_NVR_RESET_TRIGGER		BIT(0)
++
+ #define VEND1_GLOBAL_MAILBOX_INTERFACE1			0x0200
+ #define VEND1_GLOBAL_MAILBOX_INTERFACE1_EXECUTE		BIT(15)
+ #define VEND1_GLOBAL_MAILBOX_INTERFACE1_WRITE		BIT(14)
+@@ -76,7 +81,8 @@
+ #define VEND1_GLOBAL_LED_PROV_LINK100		BIT(5)
+ #define VEND1_GLOBAL_LED_PROV_RX_ACT		BIT(3)
+ #define VEND1_GLOBAL_LED_PROV_TX_ACT		BIT(2)
+-#define VEND1_GLOBAL_LED_PROV_ACT_STRETCH	GENMASK(0, 1)
++#define VEND1_GLOBAL_LED_PROV_ACT_STRETCH	GENMASK(1, 0)
++#define VEND1_GLOBAL_LED_PROV_ACT_STRETCH_100MS	0x3
+ 
+ #define VEND1_GLOBAL_LED_PROV_LINK_MASK		(VEND1_GLOBAL_LED_PROV_LINK100 | \
+ 						 VEND1_GLOBAL_LED_PROV_LINK1000 | \
+@@ -107,6 +113,7 @@
+ #define VEND1_GLOBAL_RSVD_STAT1			0xc885
+ #define VEND1_GLOBAL_RSVD_STAT1_FW_BUILD_ID	GENMASK(7, 4)
+ #define VEND1_GLOBAL_RSVD_STAT1_PROV_ID		GENMASK(3, 0)
++#define VEND1_GLOBAL_RSVD_STAT2			0xc886
+ 
+ #define VEND1_GLOBAL_RSVD_STAT9			0xc88d
+ #define VEND1_GLOBAL_RSVD_STAT9_MODE		GENMASK(7, 0)
+@@ -152,6 +159,11 @@
+ 
+ #define AQR_MAX_LEDS				3
+ 
++#define AQR_FW_RELOAD_MIN_BACKOFF_S		30
++#define AQR_FW_RELOAD_MAX_BACKOFF_S		300
++#define AQR_FW_RELOAD_MAX_FAILS			5
++#define AQR_FW_HEALTHY_RESET_S			60
++
+ struct aqr107_hw_stat {
+ 	const char *name;
+ 	int reg;
+@@ -178,6 +190,20 @@
+ 	u64 sgmii_stats[AQR107_SGMII_STAT_SZ];
+ 	unsigned long leds_active_low;
+ 	unsigned long leds_active_high;
++	unsigned long led_hw_ctrl;
++	unsigned long led_rules[AQR_MAX_LEDS];
++	struct work_struct fw_reload_work;
++	struct phy_device *phydev;
++	atomic_t fw_reloading;
++	atomic_t fw_reload_abort;
++	unsigned long last_reload_jiffies;
++	unsigned long fw_healthy_since;
++	u16 last_fw_heartbeat;
++	u8 fw_stuck_cnt;
++	u8 fw_reload_fails;
++	bool fw_hb_seen;
++	bool fw_loaded;
++	bool fw_reload_disabled;
+ };
+ 
+ #if IS_REACHABLE(CONFIG_HWMON)
+@@ -187,6 +213,7 @@
+ #endif
+ 
+ int aqr_firmware_load(struct phy_device *phydev);
++int aqr_firmware_reload(struct phy_device *phydev);
+ 
+ int aqr_phy_led_blink_set(struct phy_device *phydev, u8 index,
+ 			  unsigned long *delay_on,
+@@ -202,6 +229,7 @@
+ int aqr_phy_led_active_low_set(struct phy_device *phydev, int index, bool enable);
+ int aqr_phy_led_polarity_set(struct phy_device *phydev, int index,
+ 			     unsigned long modes);
++int aqr_phy_led_restore(struct phy_device *phydev);
+ int aqr_wait_reset_complete(struct phy_device *phydev);
+ 
+ #endif /* AQUANTIA_H */
+diff -uNr a/drivers/net/phy/aquantia/aquantia_firmware.c b/drivers/net/phy/aquantia/aquantia_firmware.c
+--- a/drivers/net/phy/aquantia/aquantia_firmware.c	2026-11-20 17:35:19.263334834 +0000
++++ b/drivers/net/phy/aquantia/aquantia_firmware.c	2026-11-20 17:39:17.182046478 +0000
+@@ -1,7 +1,9 @@
+ // SPDX-License-Identifier: GPL-2.0
+ 
+ #include <linux/bitfield.h>
++#include <linux/delay.h>
+ #include <linux/of.h>
++#include <linux/sched.h>
+ #include <linux/firmware.h>
+ #include <linux/crc-itu-t.h>
+ #include <linux/nvmem-consumer.h>
+@@ -90,18 +92,26 @@
+ static int aqr_fw_load_memory(struct phy_device *phydev, u32 addr,
+ 			      const u8 *data, size_t len)
+ {
+-	u16 crc = 0, up_crc;
++	struct aqr107_priv *priv = phydev->priv;
++	u16 crc = 0;
++	int up_crc, ret;
+ 	size_t pos;
+ 
+-	phy_write_mmd(phydev, MDIO_MMD_VEND1,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE1,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE1_CRC_RESET);
+-	phy_write_mmd(phydev, MDIO_MMD_VEND1,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE3,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE3_MSW_ADDR(addr));
+-	phy_write_mmd(phydev, MDIO_MMD_VEND1,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE4,
+-		      VEND1_GLOBAL_MAILBOX_INTERFACE4_LSW_ADDR(addr));
++	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE1,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE1_CRC_RESET);
++	if (ret)
++		return ret;
++	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE3,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE3_MSW_ADDR(addr));
++	if (ret)
++		return ret;
++	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE4,
++			    VEND1_GLOBAL_MAILBOX_INTERFACE4_LSW_ADDR(addr));
++	if (ret)
++		return ret;
+ 
+ 	/* We assume and enforce the size to be word aligned.
+ 	 * If a firmware that is not word aligned is found, please report upstream.
+@@ -110,17 +120,29 @@
+ 		u8 crc_data[4];
+ 		u32 word;
+ 
++		if (!(pos & 0x3ff)) {
++			if (priv && atomic_read(&priv->fw_reload_abort))
++				return -ECANCELED;
++			cond_resched();
++		}
++
+ 		/* FW data is always stored in little-endian */
+ 		word = get_unaligned_le32((const u32 *)(data + pos));
+ 
+-		phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE5,
+-			      VEND1_GLOBAL_MAILBOX_INTERFACE5_MSW_DATA(word));
+-		phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE6,
+-			      VEND1_GLOBAL_MAILBOX_INTERFACE6_LSW_DATA(word));
+-
+-		phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE1,
+-			      VEND1_GLOBAL_MAILBOX_INTERFACE1_EXECUTE |
+-			      VEND1_GLOBAL_MAILBOX_INTERFACE1_WRITE);
++		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE5,
++				    VEND1_GLOBAL_MAILBOX_INTERFACE5_MSW_DATA(word));
++		if (ret)
++			return ret;
++		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE6,
++				    VEND1_GLOBAL_MAILBOX_INTERFACE6_LSW_DATA(word));
++		if (ret)
++			return ret;
++
++		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE1,
++				    VEND1_GLOBAL_MAILBOX_INTERFACE1_EXECUTE |
++				    VEND1_GLOBAL_MAILBOX_INTERFACE1_WRITE);
++		if (ret)
++			return ret;
+ 
+ 		/* Word is swapped internally and MAILBOX CRC is calculated
+ 		 * using big-endian order. Mimic what the PHY does to have a
+@@ -136,6 +158,8 @@
+ 	}
+ 	/* ...gets CRC from MAILBOX after we have loaded the entire section... */
+ 	up_crc = phy_read_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_MAILBOX_INTERFACE2);
++	if (up_crc < 0)
++		return up_crc;
+ 	/* ...and make sure it does match our calculated CRC */
+ 	if (crc != up_crc) {
+ 		phydev_err(phydev, "CRC mismatch: calculated 0x%04x PHY 0x%04x\n",
+@@ -311,7 +335,7 @@
+ 	}
+ 
+ 	ret = aqr_fw_boot(phydev, buf, size, AQR_FW_SRC_NVMEM);
+-	if (ret)
++	if (ret && ret != -ECANCELED)
+ 		phydev_err(phydev, "firmware loading failed: %d\n", ret);
+ 
+ 	kfree(buf);
+@@ -341,7 +365,7 @@
+ 	}
+ 
+ 	ret = aqr_fw_boot(phydev, fw->data, fw->size, AQR_FW_SRC_FS);
+-	if (ret)
++	if (ret && ret != -ECANCELED)
+ 		phydev_err(phydev, "firmware loading failed: %d\n", ret);
+ 
+ 	release_firmware(fw);
+@@ -349,6 +373,14 @@
+ 	return ret;
+ }
+ 
++static void aqr_mark_fw_managed(struct phy_device *phydev)
++{
++	struct aqr107_priv *priv = phydev->priv;
++
++	if (priv)
++		priv->fw_loaded = true;
++}
++
+ int aqr_firmware_load(struct phy_device *phydev)
+ {
+ 	int ret;
+@@ -359,7 +391,10 @@
+ 	ret = aqr_wait_reset_complete(phydev);
+ 	switch (ret) {
+ 	case 0:
+-		/* Some firmware is loaded => do nothing */
++		/* Some firmware is loaded; manage runtime reloads if FW source exists */
++		if (of_property_present(phydev->mdio.dev.of_node, "firmware-name") ||
++		    of_property_present(phydev->mdio.dev.of_node, "nvmem-cells"))
++			aqr_mark_fw_managed(phydev);
+ 		return 0;
+ 	case -ETIMEDOUT:
+ 		/* VEND1_GLOBAL_FW_ID still reads 0 after 2 seconds of polling.
+@@ -368,12 +403,15 @@
+ 		 * assume that, and load a new image.
+ 		 */
+ 		ret = aqr_firmware_load_nvmem(phydev);
++		if (!ret)
++			aqr_mark_fw_managed(phydev);
+ 		if (ret == -EPROBE_DEFER || !ret)
+ 			return ret;
+ 
+ 		ret = aqr_firmware_load_fs(phydev);
+ 		if (ret)
+ 			return ret;
++		aqr_mark_fw_managed(phydev);
+ 		break;
+ 	default:
+ 		/* PHY read error, propagate it to the caller */
+@@ -382,3 +420,27 @@
+ 
+ 	return 0;
+ }
++
++int aqr_firmware_reload(struct phy_device *phydev)
++{
++	struct aqr107_priv *priv = phydev->priv;
++	int ret;
++
++	if (priv && atomic_read(&priv->fw_reload_abort))
++		return -ECANCELED;
++
++	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_GLOBAL_NVR_RESET,
++			    VEND1_GLOBAL_NVR_RESET_TRIGGER);
++	if (ret)
++		return ret;
++	msleep(100);
++
++	if (priv && atomic_read(&priv->fw_reload_abort))
++		return -ECANCELED;
++
++	ret = aqr_firmware_load_nvmem(phydev);
++	if (ret == -EPROBE_DEFER || ret == -ECANCELED || !ret)
++		return ret;
++
++	return aqr_firmware_load_fs(phydev);
++}
+diff -uNr a/drivers/net/phy/aquantia/aquantia_hwmon.c b/drivers/net/phy/aquantia/aquantia_hwmon.c
+--- a/drivers/net/phy/aquantia/aquantia_hwmon.c	2026-06-01 15:46:33.000000000 +0000
