
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'US'
	option disabled '0'
	option mr7500_init '1'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Linksys-MR7500-5G'
	option encryption 'psk2+ccmp'
	option disabled '0'
	option key 'LinksysMR7500!'

