#!/bin/sh
# Enable Qualcomm NSS L2/L3/NAT/PPPoE/VLAN/Bridge + ECM hardware acceleration on Linksys MR7500

ALREADY_APPLIED=$(uci -q get system.@system[0].mr7500_defaults_applied)
IS_AP_MODE=0
if [ "$(uci -q get dhcp.lan.ignore)" = "1" ] && [ -z "$(uci -q get network.wan)" ]; then
    IS_AP_MODE=1
fi

if [ "$ALREADY_APPLIED" != "1" ] && [ "$IS_AP_MODE" != "1" ]; then
    # 1. Set default LAN IP to 10.143.1.1/24 (matches Linksys factory subnet & avoids 192.168.1.0/24 upstream WAN collision)
    uci -q del network.lan.ipaddr
    uci -q del network.lan.gateway
    uci -q set network.lan.ipaddr='10.143.1.1'
    uci -q set network.lan.netmask='255.255.255.0'
    uci -q set network.lan.broadcast='10.143.1.255'
    uci -q set network.globals.packet_steering='0'
    uci -q del network.globals.steering_flows
    uci -q commit network

    # 2. Configure DHCPv4 server & IPv6 SLAAC (RFC 4862 SLAAC + RDNSS for Apple iOS/iPadOS & modern clients)
    uci -q set dhcp.lan.start='100'
    uci -q set dhcp.lan.limit='150'
    uci -q set dhcp.lan.leasetime='12h'
    uci -q set dhcp.lan.force='1'
    uci -q del dhcp.lan.dhcp_option
    uci -q add_list dhcp.lan.dhcp_option='3,10.143.1.1'
    uci -q add_list dhcp.lan.dhcp_option='6,10.143.1.1'
    uci -q del dhcp.lan.ra_flags
    uci -q add_list dhcp.lan.ra_flags='other-config'
    uci -q set dhcp.lan.ra_slaac='1'
    uci -q set dhcp.lan.ra_default='1'
    uci -q set dhcp.lan.ra='server'
    uci -q set dhcp.lan.dhcpv6='server'
    uci -q commit dhcp

    # 3. Disable conflicting software flow offloading in fw4 & enable NAT66 masquerading
    uci -q set firewall.@defaults[0].flow_offloading='0'
    uci -q set firewall.@defaults[0].flow_offloading_hw='0'
    uci -q set firewall.@zone[1].masq6='1'
    uci -q commit firewall
fi

uci -q set system.@system[0].mr7500_defaults_applied='1'
uci -q commit system

# 4. Configure ECM to use NSS hardware acceleration engine & enable bridge filtering
if [ -f /etc/config/ecm ]; then
    uci -q set ecm.global.acceleration_engine='nss'
    uci -q set ecm.general.enable_bridge_filtering='1'
    uci -q commit ecm
fi

# 5. Configure NSS dynamic RPS and 512MB pbuf auto-scaling
if [ -f /etc/config/nss ]; then
    uci -q set nss.general.enable_rps='1'
    uci -q commit nss
fi

if [ -f /etc/config/pbuf ]; then
    uci -q set pbuf.opt.memory_profile='512mb'
    uci -q set pbuf.opt.auto_scale='1'
    uci -q set pbuf.opt.scaling_governor='performance'
    uci -q commit pbuf
fi

# 6. Ensure ath11k loads with host mac80211 data path (avoids rx_desc_no_pb buffer starvation)
if [ -f /etc/modules.d/ath11k ]; then
    echo "ath11k nss_offload=0 frame_mode=0" > /etc/modules.d/ath11k
fi

# 7. Enable NSS init services on boot
for svc in skb_recycler qca-nss-ecm qca-nss-drv qca-nss-pbuf; do
    if [ -x "/etc/init.d/$svc" ]; then
        /etc/init.d/"$svc" enable 2>/dev/null || true
    fi
done

exit 0
