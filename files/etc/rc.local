#!/bin/sh
# One-shot first-boot initializer for Linksys MR7500 Tri-Band Wi-Fi 6E radios (2.4G HE40, 5G HE80, 6G HE160 OWE)
(
    # Wait up to 20s for async ath11k AHB (IPQ6018) + PCIe MHI (QCN9074 6GHz) PHYs to finish probing
    i=0
    while [ "$i" -lt 20 ]; do
        [ -d /sys/class/ieee80211/phy0 ] && [ -d /sys/class/ieee80211/phy1 ] && [ -d /sys/class/ieee80211/phy2 ] && break
        sleep 1
        i=$((i + 1))
    done

    /sbin/wifi config 2>/dev/null || true

    CHANGED=0
    for idx in 0 1 2; do
        uci -q get wireless.radio${idx} >/dev/null || continue
        [ "$(uci -q get wireless.radio${idx}.mr7500_init)" = "1" ] && continue

        band=$(uci -q get wireless.radio${idx}.band)
        uci -q set wireless.radio${idx}.country='US'
        uci -q set wireless.radio${idx}.disabled='0'
        uci -q set wireless.radio${idx}.mr7500_init='1'
        uci -q set wireless.default_radio${idx}.disabled='0'

        case "$band" in
            2g)
                uci -q set wireless.radio${idx}.channel='6'
                uci -q set wireless.radio${idx}.htmode='HE40'
                uci -q set wireless.default_radio${idx}.ssid='Linksys-MR7500-2.4G'
                uci -q set wireless.default_radio${idx}.encryption='psk2+ccmp'
                uci -q set wireless.default_radio${idx}.key='LinksysMR7500!'
                ;;
            5g)
                uci -q set wireless.radio${idx}.channel='36'
                uci -q set wireless.radio${idx}.htmode='HE80'
                uci -q set wireless.default_radio${idx}.ssid='Linksys-MR7500-5G'
                uci -q set wireless.default_radio${idx}.encryption='psk2+ccmp'
                uci -q set wireless.default_radio${idx}.key='LinksysMR7500!'
                ;;
            6g)
                # IEEE 802.11ax 6 GHz requires MFP (ieee80211w=2) and OWE or WPA3-SAE
                uci -q set wireless.radio${idx}.channel='37'
                uci -q set wireless.radio${idx}.htmode='HE160'
                uci -q set wireless.default_radio${idx}.ssid='Linksys-MR7500-6G'
                uci -q set wireless.default_radio${idx}.encryption='owe'
                uci -q set wireless.default_radio${idx}.ieee80211w='2'
                ;;
        esac
        CHANGED=1
    done

    if [ "$CHANGED" = "1" ]; then
        uci -q commit wireless
        /sbin/wifi reload
    fi
) >/tmp/mr7500-wifi-init.log 2>&1 &

exit 0
